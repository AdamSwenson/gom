{
    "name": "merpco/gradeomatic",
    "description": "Gradeomatic",
    "keywords": ["laravel", "grading"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "bugsnag/bugsnag-laravel": "^2.30",
        "doctrine/dbal": "^4.2",
        "franzose/closure-table": "^5.1",
        "guzzlehttp/guzzle": "^7.10",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^13.0",
        "pda/pheanstalk": "^7.0",
        "predis/predis": "^3.5",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "classmap": ["database"],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "franzose/closure-table"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
