<?xml version="1.0" encoding="UTF-8"?>
<database name="gom" defaultIdMethod="native">
    <behavior name="timestampable" />

    <table name="users" phpName="User">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true" />
        <column name="username" type="varchar" size="50" required="true" />
        <column name="displayname" type="varchar" size="100" required="true"/>
        <column name="password" type="varchar" size="225" required="true"/>
        <column name="email" type="varchar" size="150" required="true"/>
        <column name="activation_token" type="varchar" size="225" required="true"/>
        <column name="last_activation_request" type="integer" size="11" required="true"/>
        <column name="lost_password_request" type="integer" size="1" required="true"/>
        <column name="active" type="integer" size="1" required="true"/>
        <column name="title" type="varchar" size="150" required="true"/>
        <column name="sign_up_stamp" type="integer" size="11" required="true"/>
        <column name="last_sign_in_stamp" type="integer" size="11" required="true"/>
    </table>

    <table name="r_terms" phpName="Term">
        <column name="content" type="varchar" size="100" primaryKey="true" required="true"/>
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="term" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="r_topics" phpName="Topic">
        <column name="content" type="varchar" size="100" primaryKey="true" required="true"/>
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="topic" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="r_years" phpName="Year">
        <column name="content" type="integer" size="4" primaryKey="true" required="true"/>
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="year" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="exams" phpName="Exam">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="examTerm" type="varchar" size="100" required="true"/>
        <column name="examTopic" type="varchar" size="100" required="true"/>
        <column name="examYear" type="integer" size="4" required="true"/>
        <column name="locked" type="integer" size="1" required="true" defaultValue="0"/>
        <column name="released" type="integer" size="1" required="true" defaultValue="0"/>
        <column name="user_id" type="integer" required="true"/>
        <!--<foreign-key foreignTable="r_terms">-->
        <!--<reference local="term" foreign="content" phpName="examTerm" refPhpName="examTerm"/>-->
        <!--</foreign-key>-->
        <!--<foreign-key foreignTable="r_topics">-->
        <!--<reference local="topic" foreign="content" phpName="examTopic" refPhpName="examTopic"/>-->
        <!--</foreign-key>-->
        <!--<foreign-key foreignTable="r_years">-->
        <!--<reference local="examYear" foreign="content" phpName="year" refPhpName="year"/>-->
        <!--</foreign-key>-->
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="exam" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="questions" phpName="Question">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="questionText" type="longvarchar" required="true" />
        <column name="questionName" type="varchar" size="100" />
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="Question" onDelete="cascade"/>
        </foreign-key>
    </table>


    <table name="elements" phpName="Element">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="elementName" type="varchar" size="100" />
        <column name="displayText" type="varchar" size="225" required="true" />
        <column name="commentText" type="longvarchar" />
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="students" phpName="Student">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="sid" type="integer" required="true" />
        <column name="studentName" type="varchar" size="200" />
        <column name="email" type="varchar" size="225" />
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" onDelete="cascade"/>
        </foreign-key>
        <unique>
            <unique-column name="sid"/>
        </unique>
    </table>

    <table name="classes" phpName="Kumi">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="year" type="integer" size="4" />
        <column name="nickname" type="varchar" size="100" />
        <column name="user_id" type="integer" required="true"  />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="stockTexts" phpName="StockText">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="valence" type="varchar" />
        <column name="content" type="longvarchar" required="true" />
        <column name="type" type="varchar" />
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" onDelete="cascade"/>
        </foreign-key>
    </table>

<!--Junction tables below-->
<!--Score tables-->
    <table name="questionScores" phpName="QuestionScore" >
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="examID" type="integer" required="true" primaryKey="true"/>
        <column name="questionID" type="integer" required="true" primaryKey="true" />
        <column name="studentID" type="integer" required="true" primaryKey="true" />
        <column name="questionScore" type="float" />
        <column name="user_id" type="integer" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="questionScore" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="students">
            <reference local="studentID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="questions">
            <reference local="questionID" foreign="id"/>
        </foreign-key>
    </table>

    <table name="elementScores" phpName="ElementScore" >
        <column name="examID" type="integer" required="true" primaryKey="true" />
        <column name="elementID" type="integer" required="true" primaryKey="true" />
        <column name="studentID" type="integer" required="true" primaryKey="true" />
        <column name="user_id" type="integer" required="true"/>
        <column name="elementScore" type="float" />
        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="elements">
            <reference local="elementID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="students">
            <reference local="studentID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="ElementScore" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="examInfo" phpName="ExamInfo" >
        <column name="examID" type="integer" required="true" primaryKey="true"/>
        <column name="studentID" type="integer" required="true" primaryKey="true"/>
        <column name="user_id" type="integer" required="true" />
        <column name="completionOrder" type="integer" />
        <column name="pages" type="float" />
        <column name="notecard" type="float" />
        <column name="examGroupNumber" type="integer" />

        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="students">
            <reference local="studentID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="examInfo" onDelete="cascade"/>
        </foreign-key>
    </table>

<!--Exam constituents-->
    <table name="questionAssigner" phpName="QuestionAssigner" isCrossRef="true">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="examID" type="integer" required="true" />
        <column name="questionNumber" type="integer" size="2" required="true"  />
        <column name="user_id" type="integer" required="true" />
        <column name="questionID" type="integer" required="true" />

        <unique>
            <unique-column name="user_id"/>
            <unique-column name="examID"/>
            <unique-column name="questionNumber"/>
        </unique>

        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="questions">
            <reference local="questionID" foreign="id" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="question_assigner" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="elementXquestions" phpName="ElementAssignment" isCrossRef="true">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="examID" type="integer" required="true" />
        <column name="questionID" type="integer" required="true" />
        <column name="subtask" type="integer" size="2" required="true" />
        <column name="elementID" type="integer" required="true" />
        <column name="user_id" type="integer" required="true" />

        <unique>
            <unique-column name="user_id"/>
            <unique-column name="examID"/>
            <unique-column name="questionID"/>
            <unique-column name="subtask"/>
        </unique>
        <foreign-key foreignTable="questions">
            <!--<reference local="questionID" foreign="id" phpName="assocQuestion" refPhpName="eAssigned" onDelete="cascade"/>-->
            <reference local="questionID" foreign="id" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="elements">
            <reference local="elementID" foreign="id" onDelete="cascade"/>
            <!--<reference local="elementID" foreign="id" phpName="assocElement" refPhpName="eAssigned" onDelete="cascade"/>-->
        </foreign-key>
        <foreign-key foreignTable="exams">
            <!--<reference local="examID" foreign="id" phpName="assocExam" refPhpName="eAssigned" onDelete="cascade"/>-->
            <reference local="examID" foreign="id" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="ElementAssignment" onDelete="cascade"/>
        </foreign-key>
    </table>

<!--Class associations-->
    <table name="studentsXclasses" phpName="StudentClassAssignment" isCrossRef="true">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="studentID" type="integer" required="true" />
        <column name="classID" type="integer" required="true" />
        <column name="user_id" type="integer" required="true" />
        <unique>
            <unique-column name="studentID"/>
            <unique-column name="classID"/>
            <unique-column name="user_id"/>
        </unique>
        <foreign-key foreignTable="students">
            <reference local="studentID" foreign="id" onDelete="cascade"/>
            <!--<reference local="studentID" foreign="id" phpName="student" refPhpName="studentassignment" onDelete="cascade"/>-->
        </foreign-key>
        <foreign-key foreignTable="classes">
            <reference local="classID" foreign="id" onDelete="cascade" />
            <!--<reference local="classID" foreign="id" onDelete="cascade" phpName="kumi" refPhpName="StudentAssignment" />-->
        </foreign-key>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="studentclassassignment" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="examsXclasses" phpName="ExamClassAssignment">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="classID" type="integer" required="true" />
        <column name="examID" type="integer" required="true" />
        <column name="user_id" type="integer" required="true" />
        <unique>
            <unique-column name="examID"/>
            <unique-column name="classID"/>
            <unique-column name="user_id"/>
        </unique>
         <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="classes">
            <reference local="classID" foreign="id" onDelete="cascade" />
        </foreign-key>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="user" refPhpName="ExamClassAssignment" onDelete="cascade"/>
        </foreign-key>
    </table>

<!--Timers-->
    <table name="time_grading" phpName="GradingTime">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="examID" type="integer" required="true" />
        <column name="studentID" type="integer" required="true" />
        <column name="seconds" type="float" />
        <column name="user_id" type="integer" primaryKey="true" required="true" />
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="GradingTime" onDelete="cascade"/>
        </foreign-key>
        <unique>
            <unique-column name="examID" />
            <unique-column name="studentID" />
        </unique>
        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="students">
            <reference local="studentID" foreign="id" />
        </foreign-key>
    </table>

    <table name="time_group" phpName="GroupTime">
        <column name="examID" type="integer" required="true" primaryKey="true"/>
        <column name="groupID" type="integer" required="true" primaryKey="true"/>
        <column name="seconds" type="float" />
        <column name="user_id" type="integer" required="true" primaryKey="true"/>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="GroupTime" onDelete="cascade"/>
        </foreign-key>
        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id"/>
        </foreign-key>
     </table>

<!--Preferences-->
    <table name="preferences" phpName="Preferences">
        <column name="id" type="integer" required="true" primaryKey="true" autoIncrement="true"/>
        <column name="jqueryTheme" type="varchar" size="100" />
        <column name="autostartExam" type="boolean" />
        <column name="autostartGroup" type="boolean"/>
        <column name="dashboard_num_exams" type="integer" />
        <column name="number_questions" type="integer" />
        <column name="number_subtasks" type="integer" />
        <column name="user_id" type="integer" required="true" />
        <unique>
            <unique-column name="user_id"/>
        </unique>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="Preferences" onDelete="cascade"/>
        </foreign-key>
    </table>

    <table name="pseudoIDs" phpName="PseudoID">
        <column name="studentID" type="integer" required="true" primaryKey="true" />
        <column name="examID" type="integer" required="true" primaryKey="true" />
        <column name="pseudoID" type="varchar" size="225" required="true"/>
        <column name="user_id" type="integer" required="true" primaryKey="true"/>
        <foreign-key foreignTable="users">
            <reference local="user_id" foreign="id" phpName="User" refPhpName="PseudoID" onDelete="cascade"/>
        </foreign-key>
        <unique>
            <unique-column name="pseudoID" />
        </unique>
        <foreign-key foreignTable="exams">
            <reference local="examID" foreign="id"/>
        </foreign-key>
        <foreign-key foreignTable="students">
            <reference local="studentID" foreign="id"/>
        </foreign-key>
    </table>

