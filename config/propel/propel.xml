<?xml version="1.0" encoding="ISO-8859-1" standalone="no"?>
<config>
    <propel>
        <paths>
            <!--# The directory where Propel should output classes, sql, config, etc.-->
            <outputDir>../../app/Models/propel</outputDir>
            <!--# The directory where Propel should output generated object model classes.-->
            <phpDir>../../app/Models/propel/</phpDir>
            <phpConfDir>../../app/propel_config</phpConfDir>
            <sqlDir>../../generated-sql</sqlDir>
        </paths>
        <database>
            <connections>
                <connection id="gom">
                    <adapter>mysql</adapter>
                    <classname>Propel\Runtime\Connection\DebugPDO</classname>
                    <dsn>mysql:host=localhost;dbname=gom_propel</dsn>
                    <user>testuser4</user>
                    <password>testpass4</password>
                    <settings>
                        <charset>utf8</charset>
                        <queries>
                            <utf8>"SET NAMES utf8 COLLATE utf8_unicode_ci, COLLATION_CONNECTION = utf8_unicode_ci, COLLATION_DATABASE = utf8_unicode_ci, COLLATION_SERVER = utf8_unicode_ci"</utf8>
                        </queries>
                    </settings>
                </connection>
                <connection id="gomTest">
                    <adapter>mysql</adapter>
                    <classname>Propel\Runtime\Connection\DebugPDO</classname>
                    <dsn>mysql:host=localhost;dbname=gom_testing</dsn>
                    <user>testuser4</user>
                    <password>testpass4</password>
                    <settings>
                        <charset>utf8</charset>
                        <queries>
                            <utf8>"SET NAMES utf8 COLLATE utf8_unicode_ci, COLLATION_CONNECTION = utf8_unicode_ci, COLLATION_DATABASE = utf8_unicode_ci, COLLATION_SERVER = utf8_unicode_ci"</utf8>
                        </queries>
                    </settings>
                </connection>
            </connections>
        </database>
        <runtime>
            <defaultConnection>gom</defaultConnection>
            <connection>gom</connection>
        </runtime>
        <generator>
            <defaultConnection>gom</defaultConnection>
        </generator>
    </propel>
</config>
