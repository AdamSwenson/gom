
@import "../libraries/bootstrap-slider";

@import "components/questionPanel";
@import "components/elementArea";
@import "components/studentTable";

@import "../common/bootstrap_overrides";

.typeahead {
  border: 0px;
}

.startHidden{
  display: none;
}

.activeStudentInput {
  font-size: 1.25em;
}

.input-group.full-width .input-group-btn:last-child > .btn {
  margin-left: 5px;
}
.input-group.full-width .input-group-btn:last-child > .btn {
  border-bottom-left-radius: 4px;
  border-top-left-radius: 4px;
}
.input-group.full-width .form-control:first-child {
  border-bottom-right-radius: 4px;
  border-top-right-radius: 4px;
}

.slider-horizontal {
  margin-right: 35px;
}

.questionAndSliderColumn{
  width-max: 700px;
}

.rosterAndDashboardColumn{
  max-width: 550px;
  min-width: 340px;
}